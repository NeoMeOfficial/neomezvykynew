{
  "name": "neome-kanban",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local Kanban board to coordinate Claude chats working on the NeoMe repo.",
  "scripts": {
    "start": "node bootstrap.mjs",
    "dev": "concurrently -k -n vite,server -c blue,green \"vite\" \"node server.mjs --dev\"",
    "build": "vite build",
    "server": "node server.mjs",
    "task": "node cli.mjs"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "express": "^4.21.2",
    "node-notifier": "^10.0.1",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^3.11.0",
    "concurrently": "^9.1.0",
    "vite": "^5.4.19"
  }
}
