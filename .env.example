# ── Client (Vite) ───────────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe (client)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Optional _TEST variants override the live keys when set — REMOVE from
# the production Netlify scope before go-live or checkout stays in test mode.
# VITE_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_...

# Stripe price IDs (also read server-side by the checkout allowlist)
VITE_STRIPE_SUBSCRIPTION_PRICE_ID=price_...            # monthly 24,90 €
VITE_STRIPE_SUBSCRIPTION_QUARTERLY_PRICE_ID=price_...  # quarterly 63 €
VITE_STRIPE_SUBSCRIPTION_YEARLY_PRICE_ID=price_...     # yearly 199 €
VITE_STRIPE_MEAL_PRICE_ID=price_...                    # meal plan 57 € one-off

# Web push (client public key)
VITE_VAPID_PUBLIC_KEY=...

# ── Netlify functions (server-side only — never VITE_) ─────────
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=service_role_key
STRIPE_SECRET_KEY=sk_live_...
# STRIPE_SECRET_KEY_TEST=sk_test_...   # same go-live warning as above
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:info@neome.sk
